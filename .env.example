# GEMINI_API_KEY: Optional. In Google AI Studio, this is securely injected at runtime from user secrets.
# Never hardcode actual API keys in this file or any source code.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# APP_URL: The public URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="https://your-applet-domain.ai.studio"
